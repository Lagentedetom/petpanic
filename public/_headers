# Universal Links files MUST be served as application/json with no
# Content-Disposition. Netlify serves them as text/plain by default,
# which makes iOS reject the AASA file.
/.well-known/apple-app-site-association
  Content-Type: application/json

/.well-known/assetlinks.json
  Content-Type: application/json

# Cabeceras de seguridad (auditoría 19-10-2026). Sin CSP completa todavía:
# la app carga Supabase, teselas del mapa y Stripe; solo se bloquea que la
# metan en un iframe ajeno (clickjacking del login).
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(self), camera=(self), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains
